generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  ADMIN
  TECH
  READ_ONLY
}

enum TicketStatus {
  NEW
  TRIAGE
  IN_PROGRESS
  WAITING_ON_STAFF
  WAITING_ON_IT
  RESOLVED
  CLOSED
  MERGED
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum IncidentScope {
  LOCAL
  DIVISION_WIDE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum ImportStatus {
  PARSED
  VALIDATED
  APPLIED
  ROLLED_BACK
  FAILED
}

enum RoutingOutcome {
  EXACT
  DOMAIN
  SUGGESTED
  BODY_SIGNAL
  CONFLICT
  UNKNOWN
  MANUAL
}

enum DigestFeedback {
  UP
  DOWN
}

enum KbStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  users     User[]
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String
  role               UserRole          @default(TECH)
  imageUrl           String?
  active             Boolean           @default(true)
  teamId             String?
  team               Team?             @relation(fields: [teamId], references: [id])
  assignedTickets    Ticket[]           @relation("TicketAssignee")
  uploadedImports    DirectoryImport[]
  auditEvents        AuditLog[]
  primarySites       Site[]             @relation("PrimaryTech")
  digestFeedback     DigestReview[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([teamId, active])
}

model Site {
  id                 String            @id @default(cuid())
  name               String            @unique
  code               String            @unique
  color              String
  address            String?
  timezone           String            @default("America/Regina")
  bellSchedule       Json?
  mailDomains        String[]
  primaryTechId      String?
  primaryTech        User?             @relation("PrimaryTech", fields: [primaryTechId], references: [id])
  people             Person[]
  tickets            Ticket[]
  incidents          Incident[]
  slaPolicies        SlaPolicy[]
  routingDecisions   RoutingDecision[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([primaryTechId])
}

model Person {
  id                 String             @id @default(cuid())
  fullName           String
  normalizedName     String
  roleTitle          String?
  department         String?
  room               String?
  phone              String?
  active             Boolean            @default(true)
  external           Boolean            @default(false)
  metadata           Json?
  siteId             String?
  site               Site?              @relation(fields: [siteId], references: [id])
  aliases            PersonEmailAlias[]
  tickets            Ticket[]
  snapshots          PersonSnapshot[]
  mergedIntoId       String?
  mergedInto         Person?             @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedPeople       Person[]            @relation("PersonMerge")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([siteId, active])
  @@index([normalizedName])
  @@index([mergedIntoId])
}

model PersonEmailAlias {
  id          String   @id @default(cuid())
  email       String   @unique
  normalized  String   @unique
  isPrimary   Boolean  @default(false)
  verifiedAt  DateTime?
  source      String?
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([personId, isPrimary])
}

model PersonSnapshot {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id])
  payload     Json
  validFrom   DateTime @default(now())
  validTo     DateTime?
  tickets     Ticket[]

  @@index([personId, validFrom])
}

model DirectoryImport {
  id           String           @id @default(cuid())
  filename     String
  checksum     String
  status       ImportStatus
  mapping      Json
  rowCount     Int
  addedCount   Int              @default(0)
  updatedCount Int              @default(0)
  inactiveCount Int             @default(0)
  errors       Json?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  snapshots    DirectoryImportSnapshot[]
  createdAt    DateTime         @default(now())
  appliedAt    DateTime?
  rolledBackAt DateTime?

  @@index([createdAt(sort: Desc)])
  @@index([uploadedById, status])
}

model DirectoryImportSnapshot {
  id                String          @id @default(cuid())
  directoryImportId String
  directoryImport   DirectoryImport @relation(fields: [directoryImportId], references: [id], onDelete: Cascade)
  sequence          Int
  payload           Json
  createdAt         DateTime        @default(now())

  @@unique([directoryImportId, sequence])
}

model Ticket {
  id                    String          @id @default(cuid())
  number                Int             @unique @default(autoincrement())
  publicId              String          @unique
  subject               String
  status                TicketStatus    @default(NEW)
  priority              Priority        @default(NORMAL)
  urgency               Int             @default(2)
  impact                Int             @default(1)
  category              String?
  subcategory           String?
  affectedService       String?
  affectedCount         Int?
  roomAtIntake          String?
  siteNameAtIntake      String?
  siteCodeAtIntake      String?
  personNameAtIntake    String?
  requesterEmailAtIntake String
  routingConfidence     Float?
  frustrationScore      Float?
  recurrenceFingerprint String?
  predictedBreachAt     DateTime?
  predictedBreachRisk   Float?
  slaPausedAt           DateTime?
  waitingOn             String?
  resolution            String?
  resolvedAt            DateTime?
  closedAt              DateTime?
  teamId                String?
  team                  Team?           @relation(fields: [teamId], references: [id])
  siteId                String?
  site                  Site?           @relation(fields: [siteId], references: [id])
  personId              String?
  person                Person?         @relation(fields: [personId], references: [id])
  personSnapshotId      String?
  personSnapshot        PersonSnapshot? @relation(fields: [personSnapshotId], references: [id])
  assigneeId            String?
  assignee              User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  thread                EmailThread?
  messages              Message[]
  digests               Digest[]
  routingDecisions      RoutingDecision[]
  incidentId            String?
  incident              Incident?       @relation(fields: [incidentId], references: [id])
  mergedIntoId          String?
  mergedInto            Ticket?         @relation("TicketMerge", fields: [mergedIntoId], references: [id])
  mergedTickets         Ticket[]         @relation("TicketMerge")
  auditEvents           AuditLog[]
  kbArticles            KnowledgeArticle[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, predictedBreachRisk(sort: Desc)])
  @@index([siteId, status, createdAt(sort: Desc)])
  @@index([assigneeId, status, predictedBreachAt])
  @@index([personId, createdAt(sort: Desc)])
  @@index([recurrenceFingerprint])
  @@index([incidentId])
  @@index([mergedIntoId])
  @@index([teamId, createdAt(sort: Desc)])
}

model EmailThread {
  id                 String    @id @default(cuid())
  externalThreadId   String?   @unique
  normalizedSubject  String
  ticketId           String    @unique
  ticket             Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messages           Message[]
  lastMessageAt      DateTime?
  weldedMessageCount Int       @default(0)
  createdAt          DateTime  @default(now())

  @@index([normalizedSubject, lastMessageAt(sort: Desc)])
}

model Message {
  id                 String           @id @default(cuid())
  internetMessageId  String           @unique
  inReplyTo           String?
  references         String[]
  direction          MessageDirection
  fromAddress         String
  fromName            String?
  toAddresses         String[]
  ccAddresses         String[]
  subject             String
  textBody            String?
  htmlBodySanitized   String?
  rawStorageKey       String?
  sentAt              DateTime
  receivedAt          DateTime         @default(now())
  autoSubmitted       String?
  bounce              Boolean          @default(false)
  spoofRisk           Float?
  threadId            String?
  thread              EmailThread?     @relation(fields: [threadId], references: [id])
  ticketId            String
  ticket              Ticket           @relation(fields: [ticketId], references: [id])
  attachments         Attachment[]
  createdAt           DateTime          @default(now())

  @@index([ticketId, sentAt])
  @@index([threadId, sentAt])
  @@index([fromAddress, sentAt(sort: Desc)])
  @@index([inReplyTo])
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  contentType  String
  sizeBytes    Int
  checksum     String
  storageKey   String
  inline       Boolean  @default(false)
  contentId    String?
  ocrText      String?
  extractedIds Json?
  quarantined  Boolean  @default(false)
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([checksum])
  @@index([messageId])
}

model Digest {
  id              String           @id @default(cuid())
  ticketId        String
  ticket          Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  currentRevision Int              @default(1)
  available       Boolean          @default(true)
  failureReason   String?
  revisions       DigestRevision[]
  reviews         DigestReview[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([ticketId, updatedAt(sort: Desc)])
}

model DigestRevision {
  id                   String           @id @default(cuid())
  digestId             String
  digest               Digest           @relation(fields: [digestId], references: [id], onDelete: Cascade)
  revision             Int
  problemStatement     String
  asks                 Json
  missingInfo          Json
  suggestedFirstAction String?
  threadSummary        String?
  model                String?
  confidence           Float?
  fields               ExtractedField[]
  createdAt            DateTime         @default(now())

  @@unique([digestId, revision])
}

model ExtractedField {
  id               String         @id @default(cuid())
  digestRevisionId String
  digestRevision   DigestRevision @relation(fields: [digestRevisionId], references: [id], onDelete: Cascade)
  key              String
  value            Json
  confidence       Float
  inferred         Boolean        @default(false)
  sourceType       String
  sourceMessageId  String?
  sourceQuote      String?
  sourceStart      Int?
  sourceEnd        Int?
  directoryRef     String?

  @@index([digestRevisionId, key])
}

model DigestReview {
  id        String         @id @default(cuid())
  digestId  String
  digest    Digest         @relation(fields: [digestId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  feedback  DigestFeedback
  notes     String?
  createdAt DateTime       @default(now())

  @@index([digestId, createdAt])
  @@index([userId])
}

model RoutingDecision {
  id          String         @id @default(cuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  outcome     RoutingOutcome
  confidence  Float
  rationale   Json
  signals     Json
  siteId      String?
  site        Site?          @relation(fields: [siteId], references: [id])
  accepted    Boolean?
  correctedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@index([siteId, outcome])
}

model Incident {
  id                   String         @id @default(cuid())
  publicId             String         @unique
  title                String
  summary              String
  rootSignature        String
  scope                IncidentScope
  status               IncidentStatus @default(INVESTIGATING)
  blastRadiusEstimate  Int?
  siteId               String?
  site                 Site?          @relation(fields: [siteId], references: [id])
  tickets              Ticket[]
  startedAt            DateTime
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status, scope, startedAt(sort: Desc)])
  @@index([rootSignature])
  @@index([siteId])
}

model SlaPolicy {
  id                    String   @id @default(cuid())
  name                  String
  priority              Priority
  responseMinutes       Int
  resolutionMinutes     Int
  pauseOnWaitingStaff   Boolean  @default(true)
  travelWeight          Float    @default(1)
  businessHours         Json
  siteId                String?
  site                  Site?    @relation(fields: [siteId], references: [id])
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([siteId, priority, active])
}

model KnowledgeArticle {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  body         String
  status       KbStatus @default(DRAFT)
  category     String?
  siteCodes    String[]
  fingerprint  String?
  sourceTicketId String?
  sourceTicket Ticket?  @relation(fields: [sourceTicketId], references: [id])
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, updatedAt(sort: Desc)])
  @@index([fingerprint])
}

model Automation {
  id          String           @id @default(cuid())
  name        String
  description String?
  trigger     Json
  conditions  Json
  actions     Json
  status      AutomationStatus @default(ACTIVE)
  lastRunAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, lastRunAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  ticketId    String?
  ticket      Ticket?  @relation(fields: [ticketId], references: [id])
  before      Json?
  after       Json?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([ticketId, createdAt])
  @@index([actorId, createdAt(sort: Desc)])
}
